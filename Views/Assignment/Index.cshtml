@model List<AssignmentStorer.Controllers.Assignment>

@{
    ViewData["Title"] = "Assignments";
}

<div class="container mt-4">

    <h1>Assignment Storer</h1>
    <p>Upload and manage your assignments.</p>

    <hr />

    <h3>Upload Assignment</h3>

    <form asp-controller="Assignment"
          asp-action="Upload"
          method="post"
          enctype="multipart/form-data">

        <div class="mb-3">
            <label class="form-label">Assignment Title</label>
            <input type="text"
                   name="title"
                   class="form-control"
                   placeholder="Enter assignment title"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Subject</label>
            <input type="text"
                   name="subject"
                   class="form-control"
                   placeholder="Enter subject"
                   required />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description"
                      class="form-control"
                      rows="4"
                      placeholder="Enter assignment description"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Upload Assignment File</label>
            <input type="file"
                   name="file"
                   class="form-control"
                   required />
        </div>

        <button type="submit" class="btn btn-primary">
            Upload Assignment
        </button>

    </form>

    <hr />

    <h3>Saved Assignments</h3>

    @if (Model.Count == 0)
    {
        <p>No assignments uploaded yet.</p>
    }
    else
    {
        foreach (var assignment in Model)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-body">

                    <h4>@assignment.Title</h4>

                    <p>
                        <strong>Subject:</strong>
                        @assignment.Subject
                    </p>

                    @if (!string.IsNullOrEmpty(assignment.Description))
                    {
                        <p>
                            <strong>Description:</strong><br />
                            @assignment.Description
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(assignment.FileName))
                    {
                        <p>
                            <strong>File:</strong>
                            @assignment.FileName
                        </p>

                        <div class="d-flex gap-2">

                            <!-- VIEW -->
                            <a href="/uploads/@Uri.EscapeDataString(assignment.FileName)"
                               target="_blank"
                               class="btn btn-success">
                                View
                            </a>

                            <!-- DOWNLOAD -->
                            <a asp-controller="Assignment"
                               asp-action="Download"
                               asp-route-fileName="@assignment.FileName"
                               class="btn btn-primary">
                                Download
                            </a>

                            <!-- DELETE -->
                            <form asp-controller="Assignment"
                                  asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this assignment?');">

                                <input type="hidden"
                                       name="fileName"
                                       value="@assignment.FileName" />

                                <button type="submit"
                                        class="btn btn-danger">
                                    Delete
                                </button>

                            </form>

                        </div>
                    }

                </div>
            </div>
        }
    }

</div>
