@model IEnumerable<AssignmentStorer.Models.Assignment>

@{
    ViewData["Title"] = "Assignments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Assignments</h1>

        <a asp-action="Create" class="btn btn-primary">
            + Add Assignment
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <h5>No assignments yet.</h5>
            <p>Click "Add Assignment" to store your first assignment.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Assignment Title</th>
                        <th>Module</th>
                        <th>Description</th>
                        <th>Due Date</th>
                        <th>Uploaded</th>
                        <th>File</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var assignment in Model)
                    {
                        <tr>
                            <td>
                                @assignment.Title
                            </td>

                            <td>
                                @assignment.Module
                            </td>

                            <td>
                                @assignment.Description
                            </td>

                            <td>
                                @assignment.DueDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @assignment.UploadDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(assignment.FilePath))
                                {
                                    <a href="@assignment.FilePath"
                                       target="_blank"
                                       class="btn btn-sm btn-success">
                                        Open File
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No file
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@assignment.AssignmentId"
                                   class="btn btn-sm btn-info">
                                    View
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@assignment.AssignmentId"
                                      method="post"
                                      style="display:inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Are you sure you want to delete this assignment?');">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>